{:paths ["src"]

 ;; A durable atom for jolt: implements glimmer's IReactiveCell protocol and
 ;; persists every mutation through a pluggable backend (file, or sqlite/postgres
 ;; via jolt-lang/db). db's :jolt/native (sqlite3, optional libpq) is loaded by
 ;; jolt automatically from the git dep.
 :deps {io.github.jolt-lang/glimmer
        {:git/url "https://github.com/jolt-lang/glimmer.git"
         :git/sha "55e38f0b21b8decbcf156f56d3c9dd25a875148b"}
        io.github.jolt-lang/db
        {:git/url "https://github.com/jolt-lang/db.git"
         :git/sha "bbebf1cccbc32a6854b20f9f1e1fbb4cc5814b06"}}

 :aliases {:test {:extra-paths ["test"]
                  :main-opts ["-m" "duratom.test-runner"]}}

 :tasks {test "jolt -M:test"}}
